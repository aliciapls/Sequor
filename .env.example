# ============================================================
# Sequor — Environment Configuration
# Copy to .env and fill in your API keys:  cp .env.example .env
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/sequor

# ── LLM Configuration (Ollama — free, local AI) ────────────
# Install Ollama: https://ollama.com/download
# Pull models:    ollama pull llama3.1
#                 ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# ── Email (SendGrid) ───────────────────────────────────────
SENDGRID_API_KEY=SG.your-key-here
# For inbound webhooks: set MX record for EMAIL_FROM_DOMAIN to point to mx.sendgrid.net
# Or use SendGrid Inbound Parse (MX-less): forward emails to the inbound Parse URL
SENDGRID_WEBHOOK_VERIFICATION_KEY=  # ECDSA public key for inbound webhook verification
EMAIL_FROM_DOMAIN=localhost
EMAIL_RATE_LIMIT_PER_MINUTE=60

# ── WhatsApp (Meta Cloud API) ────────────────────────────────
# Create app at: https://developers.facebook.com
# Use WhatsApp > Test Phone Numbers to avoid business verification
WHATSAPP_ACCESS_TOKEN=EAAAYourTokenHere
WHATSAPP_PHONE_NUMBER_ID=YourPhoneNumberID
WHATSAPP_BUSINESS_ACCOUNT_ID=YourBusinessAccountID
WHATSAPP_APP_SECRET=YourAppSecret
WHATSAPP_VERIFY_TOKEN=your-verify-token  # Token for Meta webhook verification handshake
WHATSAPP_API_VERSION=v21.0
WHATSAPP_RATE_LIMIT_PER_MINUTE=250
WHATSAPP_USER_RATE_LIMIT_SECONDS=6.0

# ── Billing (Stripe) ───────────────────────────────────────
STRIPE_API_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here
STRIPE_STARTER_PRICE_ID=price_your-price-id

# ── Escalation Defaults ────────────────────────────────────
DEFAULT_ESCALATION_SLA_HOURS=4
DEFAULT_CONFIDENCE_THRESHOLD=0.90
